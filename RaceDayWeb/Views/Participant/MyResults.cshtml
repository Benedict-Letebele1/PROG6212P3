@model List<ResultResponse>
@{
    ViewData["Title"] = "My results";
    var best = Model.OrderBy(r => r.FinishPosition).FirstOrDefault();
}

<div class="rd-page-header">
    <div>
        <div class="rd-kicker">Participant</div>
        <h1>My results</h1>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="rd-card">
        <div class="rd-empty-state">
            <i class="bi bi-trophy"></i>
            <h2>No results yet</h2>
            <p>Your finish times and positions appear here once the organiser captures them after the event.</p>
            <a asp-controller="Participant" asp-action="MyEvents" class="btn btn-rd">See my enrolments</a>
        </div>
    </div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="rd-card rd-stat">
                <div class="rd-stat-icon orange"><i class="bi bi-flag-fill"></i></div>
                <div><div class="value">@Model.Count</div><div class="label">Race@(Model.Count == 1 ? "" : "s") finished</div></div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="rd-card rd-stat">
                <div class="rd-stat-icon"><i class="bi bi-award"></i></div>
                <div><div class="value">@Ui.Ordinal(best!.FinishPosition)</div><div class="label">Best finish (@best.EventName)</div></div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="rd-card rd-stat">
                <div class="rd-stat-icon lane"><i class="bi bi-trophy"></i></div>
                <div><div class="value">@Model.Count(r => r.FinishPosition <= 3)</div><div class="label">Podium finishes (top 3)</div></div>
            </div>
        </div>
    </div>

    <div class="rd-card overflow-hidden">
        <div class="table-responsive">
            <table class="table rd-table">
                <thead>
                    <tr>
                        <th>Position</th>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Category</th>
                        <th>Finish time</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        var podium = r.FinishPosition <= 3 ? $"rd-podium-{r.FinishPosition}" : "";
                        <tr>
                            <td>
                                <span class="rd-position @podium">
                                    @if (r.FinishPosition <= 3) {<i class="bi bi-trophy-fill fs-6"></i>}
                                    @Ui.Ordinal(r.FinishPosition)
                                    <small>out of @r.TotalFinishers finisher@(r.TotalFinishers == 1 ? "" : "s")</small>
                                </span>
                            </td>
                            <td><a asp-controller="Events" asp-action="Details" asp-route-id="@r.EventId" class="fw-semibold">@r.EventName</a></td>
                            <td>@Ui.Date(r.EventDate)</td>
                            <td>@r.CategoryName</td>
                            <td class="rd-time"><i class="bi bi-stopwatch text-rd"></i> @r.FinishTime</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
