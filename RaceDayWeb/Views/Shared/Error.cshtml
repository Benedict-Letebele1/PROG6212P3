@{
    ViewData["Title"] = "Something went wrong";
    var message = ViewData["Message"] as string;
}
<section class="rd-empty-state">
    <i class="bi bi-exclamation-triangle"></i>
    <h1>Something went wrong</h1>
    <p>@(message ?? "We couldn't finish that request. Please try again.")</p>
    <a class="btn btn-rd" asp-controller="Home" asp-action="Index">Back to events</a>
</section>
