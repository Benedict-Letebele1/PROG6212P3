@model EventFormViewModel
@{
    ViewData["Title"] = Model.IsEdit ? $"Edit {Model.Name}" : "Create event";
}

@if (Model.IsEdit)
{
    <partial name="_OrganiserEventTabs" model="@("Edit")" />
}
else
{
    <div class="rd-page-header">
        <div>
            <div class="rd-kicker">Organiser</div>
            <h1>Create event</h1>
        </div>
    </div>
}

<form asp-action="@(Model.IsEdit ? "Edit" : "Create")" asp-route-id="@Model.EventId" method="post" enctype="multipart/form-data" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger rd-alert"></div>
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="rd-card rd-card-body">
                <h2 class="h4">Event details</h2>
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Soweto 10km Challenge" />
                        <span asp-validation-for="Name"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Route, start point, water tables, what to bring"></textarea>
                        <span asp-validation-for="Description"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Date" class="form-label"></label>
                        <input asp-for="Date" type="datetime-local" class="form-control" value="@Model.Date?.ToString("yyyy-MM-ddTHH:mm")" />
                        <span asp-validation-for="Date"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Location" class="form-label"></label>
                        <input asp-for="Location" class="form-control" placeholder="e.g. Durban, KwaZulu-Natal" />
                        <span asp-validation-for="Location"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Distance" class="form-label"></label>
                        <input asp-for="Distance" type="number" step="0.01" min="0.01" max="999.99" class="form-control" />
                        <span asp-validation-for="Distance"></span>
                    </div>
                    <div class="col-md-6">
                        <span class="form-label d-block">Event type</span>
                        <div class="btn-group w-100" role="group" aria-label="Event type">
                            @foreach (var type in EventTypes.All)
                            {
                                <input type="radio" class="btn-check" asp-for="EventType" value="@type" id="type-@type" />
                                <label class="btn btn-rd-outline" for="type-@type"><i class="bi @Ui.EventTypeIcon(type)"></i> @type</label>
                            }
                        </div>
                        <span asp-validation-for="EventType"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="rd-card rd-card-body">
                <h2 class="h4">Banner image</h2>
                @if (Model.CurrentBannerUrl is not null)
                {
                    <img src="@Model.CurrentBannerUrl" alt="Current banner" class="rd-banner-preview mb-2" id="bannerPreview" />
                    <p class="small text-muted-rd">Choose a new file to replace this banner.</p>
                }
                else
                {
                    <img alt="Banner preview" class="rd-banner-preview mb-2" id="bannerPreview" hidden />
                }
                <input asp-for="Banner" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" data-preview="bannerPreview" />
                <div class="form-text">Optional. JPG, PNG or WebP up to 5 MB. A wide landscape image works best. It is sent to the RaceDay API, which stores it in Azure Blob Storage.</div>
            </div>

            <div class="d-grid gap-2 mt-3">
                <button type="submit" class="btn btn-rd py-2"><i class="bi bi-check2"></i> @(Model.IsEdit ? "Save changes" : "Create event")</button>
                <a asp-action="Index" class="btn btn-rd-outline">Cancel</a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
