@model List<OrganiserEventResponse>
@{
    ViewData["Title"] = "My events";
    var images = (ImageUrls)ViewData["Images"]!;
    var now = DateTime.Now;
}

<div class="rd-page-header">
    <div>
        <div class="rd-kicker">Organiser</div>
        <h1>My events</h1>
    </div>
    <a asp-action="Create" class="btn btn-rd"><i class="bi bi-plus-lg"></i> Create event</a>
</div>

@if (Model.Count == 0)
{
    <div class="rd-card">
        <div class="rd-empty-state">
            <i class="bi bi-calendar-plus"></i>
            <h2>No events yet</h2>
            <p>Create an event, upload a banner and add categories.</p>
            <a asp-action="Create" class="btn btn-rd">Create event</a>
        </div>
    </div>
}
else
{
    <div class="d-grid gap-3">
        @foreach (var e in Model)
        {
            var banner = images.Resolve(e.BannerImageUrl);
            <div class="rd-card overflow-hidden">
                <div class="row g-0 align-items-stretch">
                    <div class="col-md-3">
                        <div class="rd-event-banner h-100 @(banner is null ? "rd-banner-fallback" : "")" style="min-height: 140px; @(banner is null ? "" : $"background-image: url('{banner}')")">
                            @if (banner is null) { <i class="bi @Ui.EventTypeIcon(e.EventType)"></i> }
                            <span class="rd-type-chip @Ui.EventTypeClass(e.EventType)"><i class="bi @Ui.EventTypeIcon(e.EventType)"></i> @e.EventType</span>
                        </div>
                    </div>
                    <div class="col-md-9">
                        <div class="rd-card-body d-flex flex-column flex-lg-row gap-3 justify-content-between h-100">
                            <div>
                                <h2 class="h4 mb-1">@e.Name</h2>
                                <div class="rd-meta mb-2">
                                    <span><i class="bi bi-calendar3"></i> @Ui.DateAndTime(e.Date)</span>
                                    <span><i class="bi bi-geo-alt"></i> @e.Location</span>
                                    <span><i class="bi bi-signpost"></i> @Ui.Distance(e.Distance)</span>
                                </div>
                                <div class="small">
                                    <span class="rd-countdown me-2">@Ui.Countdown(e.Date, now)</span>
                                    @e.CategoryCount categor@(e.CategoryCount == 1 ? "y" : "ies") &middot;
                                    @e.EnrolmentCount enrolled &middot; @e.ResultCount result@(e.ResultCount == 1 ? "" : "s")
                                </div>
                                @if (e.CategoryCount == 0)
                                {
                                    <div class="small text-danger mt-1"><i class="bi bi-exclamation-circle"></i> Add a category so participants can enter.</div>
                                }
                            </div>
                            <div class="d-flex flex-wrap gap-2 align-items-start">
                                <a asp-action="Edit" asp-route-id="@e.EventId" class="btn btn-sm btn-rd-outline"><i class="bi bi-pencil"></i> Edit</a>
                                <a asp-controller="Categories" asp-action="Index" asp-route-eventId="@e.EventId" class="btn btn-sm btn-rd-outline"><i class="bi bi-tags"></i> Categories</a>
                                <a asp-controller="EventEnrolments" asp-action="Index" asp-route-eventId="@e.EventId" class="btn btn-sm btn-rd-outline"><i class="bi bi-people"></i> Enrolments</a>
                                <a asp-controller="EventResults" asp-action="Index" asp-route-eventId="@e.EventId" class="btn btn-sm btn-rd-outline"><i class="bi bi-stopwatch"></i> Results</a>
                                <a asp-action="Delete" asp-route-id="@e.EventId" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
